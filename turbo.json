{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["build:wasm-parser"],
      "outputs": ["dist/**"]
    },
    "build:wasm-parser": {
      "cache": false,
      "outputs": ["packages/elden-ring-save-parser/pkg/**"]
    },
    "lint": {
      "dependsOn": ["lint:oxlint:fix", "fmt:write", "typecheck"]
    },
    "lint:check": {
      "with": ["fmt:check", "lint:oxlint", "typecheck"]
    },
    "lint:oxlint": {},
    "lint:oxlint:fix": {},
    "lint:oxlint:fix:fix-suggestions": {},
    "fmt:write": {},
    "fmt:check": {},
    "typecheck": {}
  }
}
