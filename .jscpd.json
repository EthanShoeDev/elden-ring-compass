{
  "pattern": "**/*",
  "ignore": [
    "**/docs/**",
    "**/.turbo/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/dist/**",
    "**/pkg/**",
    "**/node_modules/**",
    "**/generated/**",
    "**/*.gen.*",
    "**/routeTree.gen.ts",
    "**/apps/web/src/assets/erdb/**",
    "**/apps/web/src/lib/elden-ring-raw-db/**",
    "**/apps/web/src/lib/map-db.ts",
    "**/apps/web/src/components/ui/**",
    "**/packages/elden-ring-save-parser/pkg/**",
    "**/packages/ER-Save-Editor/**",
    "**/packages/vendored-data/**",
    "**/map-tiles/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.cursor/**",
    "**/.opencode/**",
    "**/.github/skills/**",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/README.md"
  ],
  "threshold": 0,
  "minTokens": 50,
  "minLines": 33,
  "maxLines": 1000,
  "maxSize": "100kb"
}
