{
  "extends": "@elden-ring-compass/typescript-config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["scripts/**/*.ts", "oxlint.config.ts", "./*.ts"],
  "exclude": ["node_modules", "dist", "apps", "packages"]
}
