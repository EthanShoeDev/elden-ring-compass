{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "experimentalTailwindcss": {
    "functions": ["cn", "clsx", "cva"],
    "attributes": ["class", "className", "ngClass", ".*className"],
    "stylesheet": "apps/web/src/index.css",
  },
  "ignorePatterns": [
    "docs/cloned-repos-as-docs/**",
    "**/*.gen.*",
    "**/routeTree.gen.ts",
    "**/*.vendored.*",
    // shadcn/ui components are vendored from the registry; keep them verbatim
    // so `shadcn add --diff` stays clean. Mirrors the oxlint ignore.
    "**/components/ui/**",
    // Generated game data from the erdb project.
    "apps/web/src/assets/erdb/**",
    "apps/web/src/lib/elden-ring-raw-db/**",
    // Generated by @elden-ring-compass/extractor (codegen stage).
    "packages/data/src/generated/**",
    // Generated map-tile manifest (LFS-tracked, written by the images stage) —
    // reformatting churns the LFS oid.
    "packages/data/images/**",
    // Frozen golden parity fixtures (oracle / reference) — read as JSON, kept verbatim.
    "packages/save-parser/test/fixtures/*.json",
    // Vendored verbatim from soulstruct (EMEVD instruction dictionary).
    "packages/vendored-data/assets/er-common.emedf.json",
    "**/dist/**",
    "**/pkg/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/*.gen.*",
    "**/.turbo/**",
    "packages/ER-Save-Editor/**",
    "CLAUDE.md",
    ".agents/**",
    ".claude/skills/**",
    ".cursor/**",
    ".opencode/**",
    ".github/skills/**",
  ],
}
