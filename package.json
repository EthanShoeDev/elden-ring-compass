{
  "name": "elden-ring-compass",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@effect/atom-react": "4.1.5",
      "@effect/platform-bun": "4.1.5",
      "@effect/platform-node": "4.1.5",
      "@effect/tsgo": "0.73.4",
      "@effect/vitest": "4.1.5",
      "@playwright/test": "^1.65.1",
      "@rolldown/plugin-babel": "^0.3.1",
      "@tailwindcss/typography": "^0.5.20",
      "@tailwindcss/vite": "^4.3.5",
      "@tanstack/devtools-vite": "^0.8.7",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-start": "1.169.7",
      "@tanstack/react-table": "^9.3.1",
      "@tanstack/react-virtual": "^3.14.28",
      "@testing-library/dom": "^10.4.2",
      "@testing-library/jest-dom": "^8.0.0",
      "@testing-library/react": "^16.3.3",
      "@types/bun": "^1.4.5",
      "@types/leaflet": "^1.9.22",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vercel/analytics": "^2.0.1",
      "@vitejs/plugin-react": "^6.3.0",
      "@vitest/browser-playwright": "^5.1.1",
      "assert": "^2.1.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "date-fns": "^4.4.0",
      "effect": "4.1.5",
      "jscpd": "^5.4.3",
      "jsdom": "^31.0.1",
      "knip": "^6.48.0",
      "leaflet": "^1.9.4",
      "lucide-react": "^1.78.0",
      "lz-string": "^1.5.0",
      "nitro": "3.0.261029-rc",
      "oxfmt": "0.80.0",
      "oxlint": "1.94.0",
      "oxlint-tsgolint": "7.0.2008",
      "playwright": "^1.65.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-leaflet": "^5.0.0",
      "react-scan": "^0.5.7",
      "scheduler": "*",
      "sharp": "^0.35.5",
      "shoemaker": "0.2.9",
      "shoemaker-knip-config": "0.2.9",
      "shoemaker-oxfmt-config": "0.2.9",
      "shoemaker-oxlint-config": "0.2.9",
      "shoemaker-typescript-config": "0.2.9",
      "tailwind-merge": "^3.7.1",
      "tailwindcss": "^4.3.5",
      "turbo": "^2.11.13",
      "tw-animate-css": "^1.4.0",
      "typescript": "^7.0.2",
      "vite": "^8.3.8",
      "vitest": "^5.1.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "test": "turbo run test:run",
    "test:all": "vitest run --project extractor --project save-parser --project web",
    "test:perf": "NODE_OPTIONS=--expose-gc vitest run --project save-parser-perf",
    "test:perf:web": "vitest run --project web-perf --reporter=verbose",
    "test:bench": "vitest bench --project save-parser-perf",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "oxlint:check": "oxlint -c oxlint.config.ts .",
    "oxlint:fix": "oxlint -c oxlint.config.ts --fix .",
    "oxfmt:check": "oxfmt -c oxfmt.config.ts --check .",
    "oxfmt:fix": "oxfmt -c oxfmt.config.ts --write .",
    "jscpd:check": "NODE_OPTIONS=--max-old-space-size=8192 jscpd --config .jscpd.json",
    "knip:check": "knip --no-config-hints --cache",
    "knip:fix:danger": "knip --fix --no-config-hints --cache",
    "catalog:check": "shoemaker check catalog",
    "catalog:fix": "shoemaker check catalog --fix",
    "wiki:check": "turbo run wiki:check",
    "nix:flake:update": "nix flake update",
    "prepare": "effect-tsgo patch --oxlint",
    "effect-versions:check": "shoemaker check effect-versions",
    "update:all": "bunx taze major -r -I"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shoemaker": "catalog:",
    "shoemaker-knip-config": "catalog:",
    "shoemaker-oxfmt-config": "catalog:",
    "shoemaker-oxlint-config": "catalog:",
    "shoemaker-typescript-config": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.5"
}
