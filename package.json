{
  "name": "elden-ring-compass",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.5.0",
      "@effect/atom-react": "4.0.0-beta.75",
      "@effect/language-service": "0.86.2",
      "@effect/platform-bun": "4.0.0-beta.75",
      "@effect/platform-node": "4.0.0-beta.75",
      "@effect/tsgo": "0.13.1",
      "@effect/vitest": "4.0.0-beta.75",
      "@faker-js/faker": "^10.4.0",
      "@tailwindcss/typography": "^0.5.19",
      "@tailwindcss/vite": "^4.3.0",
      "@tanstack/devtools-vite": "^0.7.0",
      "@tanstack/react-query": "^5.100.14",
      "@tanstack/react-router": "1.170.10",
      "@tanstack/react-start": "1.168.18",
      "@tanstack/react-table": "^8.21.3",
      "@testing-library/dom": "^10.4.1",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@types/bun": "^1.3.14",
      "@types/eslint": "^9.6.1",
      "@types/leaflet": "^1.9.21",
      "@types/lz-string": "^1.5.0",
      "@types/node": "^25.9.1",
      "@types/react": "^19.2.16",
      "@types/react-dom": "^19.2.3",
      "@types/semver": "^7.7.1",
      "@typescript/native-preview": "7.0.0-dev.20260601.1",
      "@vitejs/plugin-react": "^6.0.2",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "^1.1.1",
      "comlink": "^4.4.2",
      "cross-env": "^10.1.0",
      "date-fns": "^4.4.0",
      "effect": "4.0.0-beta.75",
      "jscpd": "^4.2.4",
      "jsdom": "^29.1.1",
      "leaflet": "^1.9.4",
      "lucide-react": "^1.17.0",
      "lz-string": "^1.5.0",
      "nitro": "3.0.260522-beta",
      "oxfmt": "0.53.0",
      "oxlint": "1.68.0",
      "oxlint-tsgolint": "0.23.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "react-leaflet": "^5.0.0",
      "react-markdown": "^10.1.0",
      "react-zoom-pan-pinch": "^4.0.3",
      "semver": "^7.8.1",
      "sharp": "^0.34.5",
      "svgo": "^4.0.1",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.0",
      "tsdown": "^0.22.1",
      "turbo": "^2.9.16",
      "tw-animate-css": "^1.4.0",
      "type-fest": "^5.7.0",
      "typescript": "^6.0.3",
      "vite": "^8.0.16",
      "vite-plugin-image-optimizer": "^2.0.3",
      "vite-plugin-wasm": "^3.6.0",
      "vite-tsconfig-paths": "^6.1.1",
      "vitest": "^4.1.8",
      "zustand": "^5.0.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:wasm-parser": "cd packages/elden-ring-save-parser && wasm-pack build --target web",
    "typecheck": "tsgo --noEmit",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "oxlint:check": "oxlint -c oxlint.config.ts --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "oxlint:fix": "oxlint -c oxlint.config.ts --type-aware --type-check --report-unused-disable-directives-severity=error --fix .",
    "oxfmt:check": "oxfmt --check .",
    "oxfmt:fix": "oxfmt --write .",
    "jscpd:check": "cross-env NODE_OPTIONS=--max-old-space-size=8192 jscpd --config .jscpd.json",
    "catalog:check": "bun scripts/catalog-check.ts",
    "catalog:fix": "bun scripts/catalog-check.ts --fix",
    "nix:flake:update": "nix flake update",
    "deps:check": "ncu --deep",
    "deps:update": "ncu -u --deep",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@elden-ring-compass/config": "workspace:*",
    "@elden-ring-compass/oxlint-plugins": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native-preview": "catalog:",
    "cross-env": "catalog:",
    "effect": "catalog:",
    "jscpd": "catalog:",
    "npm-check-updates": "^22.2.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semver": "catalog:",
    "turbo": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "wasm-pack": "^0.12.1"
  },
  "packageManager": "bun@1.3.5"
}
