{
  "name": "elden-ring-compass",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/config/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@effect/atom-react": "4.0.0-rc.115",
      "@effect/language-service": "0.87.2",
      "@effect/platform-bun": "4.0.0-rc.115",
      "@effect/platform-node": "4.0.0-rc.115",
      "@effect/tsgo": "0.45.0",
      "@effect/vitest": "4.0.0-rc.115",
      "@playwright/test": "^1.63.0",
      "@rolldown/plugin-babel": "^0.2.4",
      "@tailwindcss/typography": "^0.5.20",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/devtools-vite": "^0.8.5",
      "@tanstack/react-router": "1.170.38",
      "@tanstack/react-start": "1.168.56",
      "@tanstack/react-table": "^9.2.4",
      "@tanstack/react-virtual": "^3.14.13",
      "@testing-library/dom": "^10.4.2",
      "@testing-library/jest-dom": "^7.0.1",
      "@testing-library/react": "^16.3.3",
      "@types/bun": "^1.4.2",
      "@types/eslint": "^9.6.1",
      "@types/leaflet": "^1.9.22",
      "@types/node": "^26.6.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/semver": "^7.8.0",
      "@vercel/analytics": "^2.0.1",
      "@vitejs/plugin-react": "^6.1.1",
      "@vitest/browser-playwright": "^5.0.1",
      "assert": "^2.1.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cross-env": "^10.1.0",
      "date-fns": "^4.4.0",
      "effect": "4.0.0-rc.115",
      "jscpd": "^5.2.1",
      "jsdom": "^30.1.0",
      "knip": "^6.36.0",
      "leaflet": "^1.9.4",
      "lucide-react": "^1.46.0",
      "lz-string": "^1.5.0",
      "nitro": "3.0.260903-beta",
      "oxfmt": "0.68.0",
      "oxlint": "1.82.0",
      "oxlint-tsgolint": "7.0.2001",
      "playwright": "^1.63.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-leaflet": "^5.0.0",
      "react-scan": "^0.5.7",
      "scheduler": "*",
      "semver": "^7.8.5",
      "sharp": "^0.35.4",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "tsdown": "^0.23.0",
      "turbo": "^2.10.13",
      "tw-animate-css": "^1.4.0",
      "type-fest": "^5.9.0",
      "typescript": "^7.0.2",
      "vite": "^8.3.0",
      "vitest": "^5.0.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "test": "turbo run test:run",
    "test:all": "vitest run --project extractor --project save-parser --project web",
    "test:perf": "NODE_OPTIONS=--expose-gc vitest run --project save-parser-perf",
    "test:perf:web": "vitest run --project web-perf --reporter=verbose",
    "test:bench": "vitest bench --project save-parser-perf",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "oxlint:check": "oxlint -c oxlint.config.ts --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "oxlint:fix": "oxlint -c oxlint.config.ts --type-aware --type-check --report-unused-disable-directives-severity=error --fix .",
    "oxfmt:check": "oxfmt --check . '!**/*.gen.*'",
    "oxfmt:fix": "oxfmt --write . '!**/*.gen.*'",
    "jscpd:check": "cross-env NODE_OPTIONS=--max-old-space-size=8192 jscpd --config .jscpd.json",
    "knip:check": "knip",
    "knip:fix:danger": "knip --fix",
    "catalog:check": "bun scripts/catalog-check.ts",
    "catalog:fix": "bun scripts/catalog-check.ts --fix",
    "wiki:check": "bun scripts/wiki-link-check.ts",
    "nix:flake:update": "nix flake update",
    "deps:check": "ncu --deep",
    "deps:update": "ncu -u --deep",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@elden-ring-compass/oxlint-plugins": "workspace:*",
    "@elden-ring-compass/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "cross-env": "catalog:",
    "effect": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semver": "catalog:",
    "turbo": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.2"
}
