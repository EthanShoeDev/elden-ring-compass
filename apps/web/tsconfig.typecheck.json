{
  // Typecheck entry point (`tsc -b tsconfig.typecheck.json`, the `typecheck` script). The app
  // (DOM lib) and the worker (WebWorker lib) need different libs, so they're separate programs —
  // but this solution-style config (no files of its own, just references) runs both from a single
  // build command. A `files: []` solution avoids the `composite`/emit requirements that a normal
  // project-to-project reference would impose. See tsconfig.worker.json for the why.
  "files": [],
  "references": [{ "path": "./tsconfig.json" }, { "path": "./tsconfig.worker.json" }]
}
