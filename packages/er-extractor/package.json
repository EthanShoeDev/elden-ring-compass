{
  "name": "@elden-ring-compass/er-extractor",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "er-extractor": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "bun src/bin.ts",
    "extract": "bun src/bin.ts extract",
    "build:image-codec": "cargo build --release --manifest-path ../er-image-codec/Cargo.toml",
    "update-paramdex": "bun scripts/update-paramdex.ts",
    "clean": "rm -rf .turbo dist *.tsbuildinfo",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@elden-ring-compass/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
