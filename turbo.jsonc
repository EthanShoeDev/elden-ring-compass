{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint:oxlint": {},
    "lint:oxlint:fix": {},
    "lint:oxlint:fix:fix-suggestions": {},
    "fmt:write": {},
    "fmt:check": {},
    "typecheck": {}
  }
}
