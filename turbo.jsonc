{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["NIX_*"],

  // Task-inheritance pattern (mirrors the reference monorepos):
  //   "^task"        -> run `task` in all DEPENDENCY packages first
  //   "with": [...]  -> run these tasks in parallel for the SAME package
  //   "//#task"      -> a root-only task (defined in root package.json)
  // Turbo uses shallow extend: a package overriding a task must copy the
  // whole definition, it is not merged with the root one.
  "tasks": {
    // === Base package tasks (inherited by every workspace package) ===
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nitro/**", "pkg/**"],
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
    },
    "typecheck": {
      "dependsOn": ["^build", "//#typecheck"],
    },
    "test": {
      "dependsOn": ["^build"],
    },
    "test:run": {
      "dependsOn": ["^build"],
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"],
    },

    // `lint` runs the full local pipeline for a package: typecheck plus the
    // root-only checks (oxfmt, jscpd, oxlint, catalog).
    "lint": {
      "dependsOn": ["^build"],
      "with": ["typecheck", "//#lint:root"],
    },
    "lint:check": {
      "dependsOn": ["^build"],
      "with": ["typecheck", "//#lint:check:root"],
    },

    // === Root-only tasks (the bodies live in root package.json scripts) ===
    "//#typecheck": {},
    "//#lint:root": {
      "with": [
        "//#oxfmt:fix",
        "//#jscpd:check",
        "//#oxlint:fix",
        "//#knip:fix:danger",
        "//#catalog:fix",
        "//#wiki:check",
      ],
    },
    "//#lint:check:root": {
      "with": [
        "//#oxfmt:check",
        "//#jscpd:check",
        "//#oxlint:check",
        "//#knip:check",
        "//#catalog:check",
        "//#wiki:check",
      ],
    },
    "//#oxfmt:fix": {},
    "//#oxfmt:check": {},
    "//#jscpd:check": {},
    // knip reports unused deps/exports/files; every issue type fails the gate
    // (knip.ts has no `rules` downgrades). `knip:fix:danger` (the `lint` group)
    // auto-removes dead exports/deps — "danger" because a missing entry point in
    // knip.ts would make it delete live code; review its diff like a codemod.
    "//#knip:check": {},
    "//#knip:fix:danger": {},
    "//#catalog:fix": {},
    "//#catalog:check": {},
    // Live-checks outbound wiki URLs. Manages its own result cache under
    // node_modules/.cache/wiki-link-check (verified URLs are skipped), so turbo
    // must re-run it rather than replay a cached success.
    "//#wiki:check": {
      "cache": false,
    },
    // oxlint must wait for the custom plugins to be compiled.
    "//#oxlint:fix": {
      "dependsOn": ["@elden-ring-compass/oxlint-plugins#build"],
    },
    "//#oxlint:check": {
      "dependsOn": ["@elden-ring-compass/oxlint-plugins#build"],
    },
  },
}
